{
  "name": "kompoze",
  "version": "1.0.0",
  "sideEffects": false,
  "description": "Kompoze React UI components for the web",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production vite build",
    "storybook:start": "storybook dev -p 6006",
    "dev": "yarn storybook:start",
    "storybook:build": "rm -rf storybook-static && storybook build",
    "storybook:deploy": "yarn storybook:build && node scripts/deploy-storybook.js",
    "biome:check": "biome check",
    "biome:fix": "biome lint --write ./src",
    "prepublish": "yarn build",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "tsc": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Dipankar Jana",
  "license": "MIT",
  "dependencies": {
    "classnames": "^2.2.6"
  },
  "peerDependencies": {
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-transition-group": "^4.4.1"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/kompoze.umd.js",
  "module": "./dist/kompoze.es.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/kompoze.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/kompoze.umd.js"
      }
    },
    "./dist/*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.8",
    "@storybook/addon-links": "^9.1.8",
    "@storybook/react-vite": "^9.1.8",
    "@storybook/source-loader": "^8.6.14",
    "@types/react": "^16.9.43",
    "@vitejs/plugin-react": "^4.3.1",
    "all-contributors-cli": "^6.20.0",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "dotenv": "^8.2.0",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-transition-group": "^4.4.1",
    "storybook": "^9.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vite-plugin-dts": "^4.3.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "homepage": "https://iamdipankarj.github.io/kompoze/",
  "repository": {
    "type": "git",
    "url": "git://github.com/iamdipankar/kompoze.git"
  },
  "browserslist": {
    "production": [
      ">0.01%",
      "not dead",
      "not op_mini all",
      "chrome >= 60"
    ],
    "development": [
      ">0.01%",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "optionalDependencies": {
    "@biomejs/biome": "^1.9.4",
    "gh-pages": "^6.3.0",
    "husky": "^7.0.1",
    "terser": "^5.36.0"
  },
  "packageManager": "yarn@1.22.22"
}
