{
	"$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			"node_modules",
			"dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noImplicitAnyLet": "off",
				"noArrayIndexKey": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			},
			"a11y": {
				"useAltText": "off",
				"noSvgWithoutTitle": "off",
				"noRedundantAlt": "off",
				"noLabelWithoutControl": "off",
				"useFocusableInteractive": "off",
				"useKeyWithClickEvents": "off",
				"useSemanticElements": "off",
				"useMediaCaption": "off"
			},
			"style": {
				"noUselessElse": "off",
				"useTemplate": "off",
				"noNonNullAssertion": "off",
				"useExponentiationOperator": "off",
				"useDefaultParameterLast": "off"
			},
			"complexity": {
				"useLiteralKeys": "off",
				"noUselessTernary": "off",
				"noThisInStatic": "off",
				"noForEach": "off",
				"noBannedTypes": "off",
				"useOptionalChain": "off"
			},
			"performance": {
				"noAccumulatingSpread": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	}
}
