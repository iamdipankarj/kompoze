{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "lib": [
      "dom",
      "es2020"
    ],
    "baseUrl": ".",
    "rootDir": "./src",
    "outDir": "./dist",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "removeComments": true,
    "jsx": "react",
    "noImplicitAny": false,
    "declaration": true,
    "declarationDir": "dist",
    "strictNullChecks": true,
    "stripInternal": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "src/*", ".storybook/**/*", "src/global.d.ts"],
  "typeRoots": ["./node_modules/@types"],
  "exclude": [
    "node_modules",
    "build",
    "scripts",
    ".storybook",
    "dist",
    ".vscode"
  ]
}
